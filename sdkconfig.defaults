# Override some defaults so BT stack is enabled and
# Classic BT is enabled
CONFIG_BT_ENABLED=y
CONFIG_BT_BLE_ENABLED=n
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BTDM_CTRL_BR_EDR_MAX_SYNC_CONN=1
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_HFP_ENABLE=y
CONFIG_BT_HFP_AG_ENABLE=y
CONFIG_BT_HFP_CLIENT_ENABLE=n
CONFIG_BT_HFP_AUDIO_DATA_PATH_HCI=y
CONFIG_BTDM_CTRL_BR_EDR_SCO_DATA_PATH_HCI=y

# Louder ESP32 Rev H6 hardware defaults
CONFIG_I2S_BCLK_GPIO=26
CONFIG_I2S_LRCLK_GPIO=25
CONFIG_I2S_DOUT_GPIO=22
CONFIG_LOUDER_TAS5805M_SDA_GPIO=21
CONFIG_LOUDER_TAS5805M_SCL_GPIO=27
CONFIG_LOUDER_TAS5805M_PWDN_GPIO=33
CONFIG_LOUDER_TAS5805M_FAULT_GPIO=34
CONFIG_LOUDER_TAS5805M_I2C_ADDR=45
CONFIG_LOUDER_TAS5805M_I2C_FREQ_HZ=100000
CONFIG_LOUDER_ANALOG_GAIN_STEPS=0
CONFIG_VOLUME_POT_GPIO=36
CONFIG_VOLUME_MAX_PERCENT=60
CONFIG_VOLUME_HYSTERESIS_PERCENT=2
CONFIG_VOLUME_POLL_INTERVAL_MS=100
# CONFIG_ENABLE_SD_RECORDING is not set
# CONFIG_ENABLE_HEADSET_RESET_GPIO is not set
