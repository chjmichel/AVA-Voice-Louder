CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

CONFIG_COMPILER_OPTIMIZATION_PERF=y

CONFIG_HFP_MIC_DEFAULT_GAIN=10

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# CM108B USB audio / central mixer
CONFIG_CM108B_BCLK_GPIO=18
CONFIG_CM108B_LRCLK_GPIO=19
CONFIG_CM108B_DATA_GPIO=23
CONFIG_CM108B_DIAG_RX_STATS=y
# CONFIG_CM108B_DIAG_1KHZ_TONE is not set
CONFIG_AUDIO_MIX_USB_GAIN_PERCENT=70
CONFIG_AUDIO_MIX_HFP_GAIN_PERCENT=100
CONFIG_AUDIO_MIX_JINGLE_GAIN_PERCENT=100
CONFIG_AUDIO_MIX_JINGLE_DUCK_PERCENT=0
